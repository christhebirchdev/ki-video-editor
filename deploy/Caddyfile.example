# =============================================================
# Caddy Reverse-Proxy für den AI Video Analyst
# Auto-HTTPS (Let's Encrypt) + ein gemeinsames Passwort + Proxy auf den lokalen Dienst.
#
# Vorbereitung (einmalig, in der Server-Phase – ich gebe dir die genauen Befehle):
#   1. DNS: A-Record  analyst.DEINE-DOMAIN.de  ->  VPS-IP  setzen (bei Hostinger).
#   2. Passwort-Hash erzeugen:   caddy hash-password
#      -> Passwort eintippen, Hash kopieren und unten bei <BCRYPT_HASH> einsetzen.
#   3. Diese Datei (ohne .example) nach /etc/caddy/Caddyfile legen, Werte ersetzen,
#      dann:  sudo systemctl reload caddy
#
# ACHTUNG: Läuft auf dem VPS schon ein Proxy (nginx/Traefik) auf Port 80/443 für n8n,
# darf Caddy diese Ports NICHT parallel belegen. Dann stattdessen einen vhost im
# bestehenden Proxy anlegen — das klären wir in der Server-Phase zuerst.
# =============================================================

analyst.DEINE-DOMAIN.de {
    # Ein Login für alle 3 Nutzer. Benutzername "team", Passwort = der Hash unten.
    # Mehrere Nutzer/Passwörter? Einfach weitere Zeilen "name <hash>" ergänzen.
    basic_auth {
        team <BCRYPT_HASH>
    }

    # Große Video-Uploads erlauben (Default wäre je nach Version knapp).
    request_body {
        max_size 2GB
    }

    encode gzip

    # An den lokal gebundenen FastAPI-Dienst weiterreichen.
    reverse_proxy 127.0.0.1:8001 {
        # Lange Analysen nicht vorzeitig abbrechen.
        transport http {
            read_timeout 1h
            write_timeout 1h
        }
    }
}
