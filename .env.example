# KI Video Editor — Umgebungsvariablen
# Diese Datei als .env speichern und echte Keys eintragen

# Google AI API Key (https://aistudio.google.com/apikey)
# WICHTIG: Key muss mit "AIza..." beginnen — falls nicht, neuen Key erstellen
GEMINI_API_KEY=AIza...

# Anthropic API Key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# AssemblyAI API Key (https://www.assemblyai.com/app)
ASSEMBLYAI_API_KEY=...

# Server-Einstellungen
PROJECTS_DIR=projects
MEMORY_DIR=memory
HOST=0.0.0.0
PORT=8001

# --- Server-Deployment (nur auf dem VPS setzen; lokal weglassen) ---
# Nur den Video-Analyst ausliefern, Editor komplett ausblenden/abschalten:
ANALYST_ONLY=1
# Whisper-Modell für die Transkription. Auf schwachem VPS "base" oder "tiny":
WHISPER_MODEL=small
# Wie viele Analysen gleichzeitig laufen dürfen (Rest wartet in der Schlange):
ANALYST_MAX_CONCURRENT=1
